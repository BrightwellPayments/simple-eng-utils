# Copy to .env and fill in. .env is gitignored and MUST NOT be shared —
# each person mints their own token.

# LaunchDarkly REST API access token. Reader scope is sufficient; this tool never
# writes to LaunchDarkly. Create in LD: Account settings -> Authorization -> Access tokens.
LD_API_TOKEN=

# LD project key.
LD_PROJECT_KEY=ready-remit

# Where reports are written. Defaults to ../../Plans relative to this repo
# (i.e. C:\Code\Plans when the repo sits at C:\Code\ld-flag-compare).
# OUT_DIR=

# ---------------------------------------------------------------------------
# Defaults for `npm run compare`. Every one is overridable on the command line,
# and the command line always wins. Valid environments in the ReadyRemit project:
# qa, staging, sandbox, uat, dev, production.
# ---------------------------------------------------------------------------

# Default environments for the left and right side of a comparison.
LD_ENV_LEFT=production
LD_ENV_RIGHT=uat

# Default customer name for BOTH sides — used by the cross-environment mode.
# This is the customer's `name` as LaunchDarkly stores it; targeting rules match
# on it. Override per side with --left-customer / --right-customer.
CUSTOMER_NAME=

# ---------------------------------------------------------------------------
# Defaults for the audit scripts (`npm run audit` and friends).
# ---------------------------------------------------------------------------

# Environment to audit. Output filenames are keyed off this, so prod/uat/dev runs
# don't clobber each other.
AUDIT_ENV=production
